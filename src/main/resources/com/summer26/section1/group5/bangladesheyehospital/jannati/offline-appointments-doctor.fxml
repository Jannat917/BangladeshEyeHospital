<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="650.0" prefWidth="900.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.summer26.section1.group5.bangladesheyehospital.jannati.OfflineAppointmentsDoctorController">

    <children>

        <Label layoutX="300.0" layoutY="20.0" text="Offline Appointments">
            <font>
                <Font size="24.0" />
            </font>
        </Label>

        <!-- Filters -->

        <Label layoutX="30.0" layoutY="80.0" text="Appointment Date" />

        <DatePicker fx:id="datePicker" layoutX="150.0" layoutY="75.0" prefWidth="160.0" />

        <Label layoutX="340.0" layoutY="80.0" text="Doctor ID" />

        <TextField fx:id="doctorIdTextField" layoutX="420.0" layoutY="75.0" prefWidth="120.0" />

        <Label layoutX="570.0" layoutY="80.0" text="Time" />

        <ComboBox fx:id="timeComboBox" layoutX="620.0" layoutY="75.0" prefWidth="130.0" />

        <Button layoutX="770.0" layoutY="75.0" onAction="#filterButton" prefWidth="90.0" text="Filter" />

        <!-- Table -->

        <TableView fx:id="appointmentTableView" layoutX="30.0" layoutY="140.0" prefHeight="400.0" prefWidth="840.0">

            <columns>

                <TableColumn fx:id="patientIdColumn" prefWidth="146.0" text="Patient ID" />

                <TableColumn fx:id="patientNameColumn" prefWidth="114.0" text="Patient Name" />

                <TableColumn fx:id="doctorIdColumn" prefWidth="128.0" text="Doctor ID" />

                <TableColumn fx:id="dateColumn" prefWidth="112.0" text="Date" />

                <TableColumn fx:id="timeColumn" prefWidth="171.0" text="Time" />

                <TableColumn fx:id="statusColumn" prefWidth="168.0" text="Status" />

            </columns>

        </TableView>

        <Button layoutX="610.0" layoutY="575.0" onAction="#clearButton" prefWidth="100.0" text="Clear" />

        <Button layoutX="740.0" layoutY="575.0" onAction="#backButton" prefWidth="100.0" text="Back" />

        <Label fx:id="messageLabel" layoutX="30.0" layoutY="620.0" prefWidth="600.0" />

    </children>

</AnchorPane>
