<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="650.0" prefWidth="900.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.summer26.section1.group5.bangladesheyehospital.jannati.DiagnosticReportsController">

    <children>

        <Label layoutX="280.0" layoutY="20.0" text="Diagnostic Reports">
            <font>
                <Font size="26" />
            </font>
        </Label>

        <!-- Search -->

        <Label layoutX="40.0" layoutY="80.0" text="Patient ID" />

        <TextField fx:id="patientIdTextField" layoutX="120.0" layoutY="75.0" prefWidth="150.0" />

        <Button layoutX="290.0" layoutY="74.0" onAction="#searchButton" text="Search" />

        <!-- Previous Reports -->

        <TableView fx:id="reportTableView" layoutX="40.0" layoutY="120.0" prefHeight="220.0" prefWidth="820.0">

            <columns>

                <TableColumn fx:id="dateColumn" prefWidth="269.0" text="Report Date" />

                <TableColumn fx:id="testNameColumn" prefWidth="244.0" text="Test Name" />

                <TableColumn fx:id="diagnosisColumn" prefWidth="306.0" text="Diagnosis" />

            </columns>

        </TableView>

        <!-- Report Entry -->

        <Label layoutX="40.0" layoutY="375.0" text="Report Date" />

        <DatePicker fx:id="reportDatePicker" layoutX="170.0" layoutY="370.0" prefWidth="180.0" />

        <Label layoutX="390.0" layoutY="375.0" text="Test Name" />

        <TextField fx:id="testNameTextField" layoutX="500.0" layoutY="370.0" prefWidth="220.0" />

        <Label layoutX="40.0" layoutY="425.0" text="Diagnosis" />

        <TextArea fx:id="diagnosisTextArea" layoutX="170.0" layoutY="420.0" prefHeight="70.0" prefWidth="550.0" />

        <Label layoutX="40.0" layoutY="510.0" text="Result" />

        <TextArea fx:id="resultTextArea" layoutX="170.0" layoutY="505.0" prefHeight="60.0" prefWidth="550.0" />

        <!-- Buttons -->

        <Button layoutX="750.0" layoutY="370.0" onAction="#saveReportButton" prefWidth="110.0" text="Save Report" />

        <Button layoutX="750.0" layoutY="420.0" onAction="#viewReportButton" prefWidth="110.0" text="View Report" />

        <Button layoutX="750.0" layoutY="470.0" onAction="#clearButton" prefWidth="110.0" text="Clear" />

        <Button layoutX="750.0" layoutY="575.0" onAction="#backButton" prefWidth="110.0" text="Back" />

        <Label fx:id="messageLabel" layoutX="40.0" layoutY="635.0" prefWidth="700.0" />

    </children>

</AnchorPane>
