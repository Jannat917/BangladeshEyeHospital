<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="700.0" prefWidth="900.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.summer26.section1.group5.bangladesheyehospital.jannati.UpdatePatientInfoReceptionistController">

    <children>

        <!-- Header -->

        <Label layoutX="250.0" layoutY="25.0" text="Bangladesh Eye Hospital">
            <font>
                <Font size="28" />
            </font>
        </Label>

        <Label layoutX="315.0" layoutY="70.0" text="Update Patient Information">
            <font>
                <Font size="20" />
            </font>
        </Label>

        <!-- Search -->

        <Label layoutX="80.0" layoutY="140.0" text="Patient ID" />

        <TextField fx:id="patientIdTextField" layoutX="180.0" layoutY="135.0" prefWidth="180.0" />

        <Button layoutX="390.0" layoutY="134.0" onAction="#searchButton" prefWidth="90.0" text="Search" />

        <!-- Patient Information -->

        <Label layoutX="80.0" layoutY="210.0" text="Patient Name" />

        <TextField fx:id="patientNameTextField" layoutX="180.0" layoutY="205.0" prefWidth="250.0" />

        <Label layoutX="94.0" layoutY="342.0" text="Age" />

        <TextField fx:id="ageTextField" layoutX="190.0" layoutY="337.0" prefWidth="80.0" />

        <Label layoutX="80.0" layoutY="270.0" text="Gender" />

        <ComboBox fx:id="genderComboBox" layoutX="190.0" layoutY="266.0" prefWidth="180.0" />

        <Label layoutX="83.0" layoutY="393.0" text="Phone" />

        <TextField fx:id="phoneTextField" layoutX="190.0" layoutY="397.0" prefWidth="180.0" />

        <Label layoutX="83.0" layoutY="456.0" text="Address" />

        <TextField fx:id="addressTextField" layoutX="180.0" layoutY="451.0" prefWidth="560.0" />

        <!-- Message -->

        <Label fx:id="messageLabel" layoutX="396.0" layoutY="247.0" prefHeight="65.0" prefWidth="250.0" />

        <!-- Buttons -->

        <Button layoutX="230.0" layoutY="568.0" onAction="#updateButton" prefWidth="120.0" text="Update" />

        <Button layoutX="390.0" layoutY="568.0" onAction="#clearButton" prefWidth="120.0" text="Clear" />

        <Button layoutX="620.0" layoutY="620.0" onAction="#backButton" prefWidth="100.0" text="Back" />

    </children>

</AnchorPane>
