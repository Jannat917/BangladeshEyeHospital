<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="700.0" prefWidth="900.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.summer26.section1.group5.bangladesheyehospital.jannati.ManagePaymentController">

    <children>

        <!-- Header -->

        <Label layoutX="250.0" layoutY="20.0" text="Bangladesh Eye Hospital">
            <font>
                <Font size="28" />
            </font>
        </Label>

        <Label layoutX="320.0" layoutY="65.0" text="Manage Payment Information">
            <font>
                <Font size="20" />
            </font>
        </Label>

        <!-- Search -->

        <Label layoutX="70.0" layoutY="130.0" text="Patient ID" />

        <TextField fx:id="patientIdTextField" layoutX="170.0" layoutY="125.0" prefWidth="150.0" />

        <Button layoutX="350.0" layoutY="124.0" onAction="#searchButton" prefWidth="90.0" text="Search" />

        <!-- Patient Information -->

        <Label layoutX="70.0" layoutY="190.0" text="Patient Name" />

        <TextField fx:id="patientNameTextField" editable="false" layoutX="170.0" layoutY="185.0" prefWidth="250.0" />

        <!-- Payment -->

        <Label layoutX="70.0" layoutY="260.0" text="Payment Amount" />

        <TextField fx:id="paymentAmountTextField" layoutX="170.0" layoutY="255.0" prefWidth="180.0" />

        <!-- Buttons -->

        <Button layoutX="220.0" layoutY="330.0" onAction="#donePaymentButton" prefWidth="140.0" text="Done Payment" />

        <Button layoutX="400.0" layoutY="330.0" onAction="#clearButton" prefWidth="100.0" text="Clear" />

        <!-- Payment Table -->

        <TableView fx:id="paymentTableView" layoutX="40.0" layoutY="400.0" prefHeight="220.0" prefWidth="820.0">

            <columns>

                <TableColumn fx:id="patientIdColumn" prefWidth="100.0" text="Patient ID" />

                <TableColumn fx:id="patientNameColumn" prefWidth="220.0" text="Patient Name" />

                <TableColumn fx:id="billAmountColumn" prefWidth="180.0" text="Bill Amount" />

                <TableColumn fx:id="paymentStatusColumn" prefWidth="180.0" text="Payment Status" />

            </columns>

        </TableView>

        <!-- Message -->

        <Label fx:id="messageLabel" layoutX="200.0" layoutY="640.0" prefWidth="400.0" />

        <!-- Back -->

        <Button layoutX="740.0" layoutY="640.0" onAction="#backButton" prefWidth="100.0" text="Back" />

    </children>

</AnchorPane>
