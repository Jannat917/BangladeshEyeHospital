<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="700.0" prefWidth="950.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.summer26.section1.group5.bangladesheyehospital.jannati.GenerateTestBillController">

    <children>

        <!-- Header -->

        <Label layoutX="255.0" layoutY="20.0" text="Bangladesh Eye Hospital">
            <font>
                <Font size="28" />
            </font>
        </Label>

        <Label layoutX="335.0" layoutY="65.0" text="Generate Test Bill">
            <font>
                <Font size="20" />
            </font>
        </Label>

        <!-- Search Patient -->

        <Label layoutX="50.0" layoutY="120.0" text="Patient ID" />

        <TextField fx:id="patientIdTextField" layoutX="130.0" layoutY="115.0" prefWidth="120.0" />

        <Button layoutX="270.0" layoutY="114.0" onAction="#searchButton" text="Search" />

        <Label layoutX="390.0" layoutY="120.0" text="Patient Name" />

        <TextField fx:id="patientNameTextField" editable="false" layoutX="490.0" layoutY="115.0" prefWidth="250.0" />

        <!-- Test List -->

        <Label layoutX="50.0" layoutY="175.0" text="Select Tests">
            <font>
                <Font size="16" />
            </font>
        </Label>

        <CheckBox fx:id="bloodTestCheckBox" layoutX="60.0" layoutY="210.0" text="Blood Test (500 Tk)" />

        <CheckBox fx:id="eyePressureCheckBox" layoutX="60.0" layoutY="245.0" text="Eye Pressure Test (700 Tk)" />

        <CheckBox fx:id="visualFieldCheckBox" layoutX="60.0" layoutY="280.0" text="Visual Field Test (1200 Tk)" />

        <CheckBox fx:id="octCheckBox" layoutX="330.0" layoutY="210.0" text="OCT (2500 Tk)" />

        <CheckBox fx:id="cornealCheckBox" layoutX="330.0" layoutY="245.0" text="Corneal Topography (1800 Tk)" />

        <CheckBox fx:id="retinaScanCheckBox" layoutX="330.0" layoutY="280.0" text="Retina Scan (2000 Tk)" />

        <!-- Total Bill -->

        <Label layoutX="403.0" layoutY="158.0" text="Total Bill" />

        <TextField fx:id="totalBillTextField" editable="false" layoutX="490.0" layoutY="154.0" prefWidth="150.0" />

        <!-- Buttons -->

        <Button layoutX="170.0" layoutY="340.0" onAction="#calculateButton" prefWidth="140.0" text="Calculate Bill" />

        <Button layoutX="350.0" layoutY="340.0" onAction="#generateButton" prefWidth="140.0" text="Generate Bill" />

        <Button layoutX="530.0" layoutY="340.0" onAction="#clearButton" prefWidth="100.0" text="Clear" />

        <!-- Table -->

        <TableView fx:id="billTableView" layoutX="30.0" layoutY="400.0" prefHeight="220.0" prefWidth="890.0">

            <columns>

                <TableColumn fx:id="patientIdColumn" prefWidth="120.0" text="Patient ID" />

                <TableColumn fx:id="patientNameColumn" prefWidth="180.0" text="Patient Name" />

                <TableColumn fx:id="testsColumn" prefWidth="420.0" text="Selected Tests" />

                <TableColumn fx:id="totalColumn" prefWidth="170.0" text="Total Amount" />

            </columns>

        </TableView>

        <!-- Message -->

        <Label fx:id="messageLabel" layoutX="220.0" layoutY="640.0" prefWidth="450.0" />

        <!-- Back -->

        <Button layoutX="790.0" layoutY="640.0" onAction="#backButton" prefWidth="90.0" text="Back" />

    </children>

</AnchorPane>
