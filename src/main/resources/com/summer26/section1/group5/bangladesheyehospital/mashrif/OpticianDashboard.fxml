<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>
<AnchorPane prefHeight="650.0" prefWidth="950.0" style="-fx-background-color: white;"
 xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
 fx:controller="com.summer26.section1.group5.bangladesheyehospital.mashrif.OpticianDashboard">
 <children>
  <VBox spacing="14.0" prefWidth="950.0" prefHeight="650.0">
   <padding><Insets top="24" right="28" bottom="24" left="28"/></padding>
   <children>
    <Label text="Optician Dashboard"><font><Font name="System Bold" size="28"/></font></Label>
    <GridPane hgap="12" vgap="12">
     <children>
      <Button text="Dashboard" onAction="#dashboardButton" prefWidth="200" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
      <Button text="View Prescriptions" onAction="#viewPrescriptionButton" prefWidth="200" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
      <Button text="Recommend Frame" onAction="#recommendFrameButton" prefWidth="200" GridPane.columnIndex="2" GridPane.rowIndex="0"/>
      <Button text="Create Order" onAction="#createOrderButton" prefWidth="200" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
      <Button text="Track Production" onAction="#trackProductionButton" prefWidth="200" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
      <Button text="Deliver Eyeglass" onAction="#deliverEyeglassButton" prefWidth="200" GridPane.columnIndex="2" GridPane.rowIndex="1"/>
      <Button text="Frame Inventory" onAction="#inventoryButton" prefWidth="200" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
      <Button text="Frame Sales" onAction="#frameSaleButton" prefWidth="200" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
      <Button text="Optical Report" onAction="#opticalReportButton" prefWidth="200" GridPane.columnIndex="2" GridPane.rowIndex="2"/>
      <Button text="Logout" onAction="#logoutButton" prefWidth="200" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
     </children>
    </GridPane>
    <Label fx:id="statusLabel" text="Ready" style="-fx-border-color: black; -fx-padding: 10;"/>
   </children>
  </VBox>
 </children>
</AnchorPane>