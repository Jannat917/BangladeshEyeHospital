<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="700.0" prefWidth="950.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.summer26.section1.group5.bangladesheyehospital.jannati.SurgeryController">

    <children>

        <Label layoutX="310.0" layoutY="20.0" text="Manage Surgery Schedule">
            <font>
                <Font size="24" />
            </font>
        </Label>

        <!-- Search -->

        <Label layoutX="40.0" layoutY="80.0" text="Patient ID" />

        <TextField fx:id="patientIdTextField" layoutX="150.0" layoutY="76.0" prefWidth="180.0" />

        <Button layoutX="360.0" layoutY="76.0" onAction="#searchButton" prefWidth="90.0" text="Search" />

        <Label layoutX="514.0" layoutY="80.0" text="Patient Name" />

        <TextField fx:id="patientNameTextField" editable="false" layoutX="610.0" layoutY="76.0" prefWidth="220.0" />

        <!-- Surgery Details -->

        <Label layoutX="40.0" layoutY="150.0" text="Surgery Type" />

        <ComboBox fx:id="surgeryTypeComboBox" layoutX="150.0" layoutY="145.0" prefWidth="220.0" />

        <Label layoutX="523.0" layoutY="142.0" text="Room No." />

        <TextField fx:id="roomNumberTextField" layoutX="622.0" layoutY="137.0" prefWidth="120.0" />

        <Label layoutX="40.0" layoutY="210.0" text="Surgery Date" />

        <DatePicker fx:id="datePicker" layoutX="150.0" layoutY="205.0" />

        <Label layoutX="523.0" layoutY="211.0" text="Time" />

        <ComboBox fx:id="timeComboBox" layoutX="610.0" layoutY="206.0" prefWidth="180.0" />

        <!-- Buttons -->

        <Button layoutX="280.0" layoutY="275.0" onAction="#doneButton" prefWidth="120.0" text="Done" />

        <Button layoutX="430.0" layoutY="275.0" onAction="#clearButton" prefWidth="120.0" text="Clear" />

        <Button layoutX="763.0" layoutY="627.0" onAction="#backButton" prefWidth="120.0" text="Back" />

        <!-- Table -->

        <TableView fx:id="surgeryTableView" layoutX="25.0" layoutY="340.0" prefHeight="227.0" prefWidth="900.0">

            <columns>

                <TableColumn fx:id="patientIdColumn" prefWidth="90.0" text="Patient ID" />

                <TableColumn fx:id="patientNameColumn" prefWidth="160.0" text="Patient Name" />

                <TableColumn fx:id="surgeryTypeColumn" prefWidth="170.0" text="Surgery Type" />

                <TableColumn fx:id="roomColumn" prefWidth="100.0" text="Room" />

                <TableColumn fx:id="dateColumn" prefWidth="160.0" text="Date" />

                <TableColumn fx:id="timeColumn" prefWidth="180.0" text="Time" />

            </columns>

        </TableView>

        <Label fx:id="messageLabel" layoutX="30.0" layoutY="660.0" prefWidth="700.0" />

    </children>

</AnchorPane>
