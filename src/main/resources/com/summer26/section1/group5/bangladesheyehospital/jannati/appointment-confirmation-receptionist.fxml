<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="700.0" prefWidth="950.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.summer26.section1.group5.bangladesheyehospital.jannati.AppointmentConfirmationReceptionistController">

    <children>

        <!-- Header -->

        <Label layoutX="250.0" layoutY="20.0" text="Bangladesh Eye Hospital">
            <font>
                <Font size="28" />
            </font>
        </Label>

        <Label layoutX="300.0" layoutY="60.0" text="Appointment Confirmation">
            <font>
                <Font size="20" />
            </font>
        </Label>

        <!-- Appointment Table -->

        <TableView fx:id="appointmentTableView" layoutX="14.0" layoutY="198.0" prefHeight="340.0" prefWidth="833.0">

            <columns>

                <TableColumn fx:id="patientIdColumn" prefWidth="90.0" text="Patient ID" />

                <TableColumn fx:id="patientNameColumn" prefWidth="103.0" text="Patient Name" />

                <TableColumn fx:id="doctorColumn" prefWidth="123.0" text="Doctor" />

                <TableColumn fx:id="doctorIdColumn" prefWidth="184.0" text="Doctor Id" />

                <TableColumn fx:id="dateColumn" prefWidth="110.0" text="Date" />

                <TableColumn fx:id="timeColumn" prefWidth="113.0" text="Time" />

                <TableColumn fx:id="typeColumn" prefWidth="113.0" text="Type" />

                <TableColumn fx:id="statusColumn" prefWidth="104.0" text="Status" />

            </columns>

        </TableView>

        <!-- Message -->

        <Label fx:id="messageLabel" layoutX="220.0" layoutY="565.0" prefWidth="500.0" />

        <!-- Buttons -->

        <Button layoutX="397.0" layoutY="133.0" onAction="#confirmButton" prefHeight="34.0" prefWidth="157.0" text="Send Confirmation" />

        <Button layoutX="577.0" layoutY="133.0" onAction="#refreshButton" prefHeight="34.0" prefWidth="100.0" text="Refresh" />

        <Button layoutX="740.0" layoutY="610.0" onAction="#backButton" prefHeight="26.0" prefWidth="120.0" text="Back" />

    </children>

</AnchorPane>
