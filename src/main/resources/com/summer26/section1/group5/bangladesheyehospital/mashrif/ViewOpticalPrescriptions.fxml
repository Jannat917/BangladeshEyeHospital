<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>
<AnchorPane prefHeight="700" prefWidth="1000" style="-fx-background-color: white;"
 xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
 fx:controller="com.summer26.section1.group5.bangladesheyehospital.mashrif.ViewOpticalPrescriptionsController">
 <children><VBox spacing="12" prefWidth="1000" prefHeight="700">
  <padding><Insets top="20" right="24" bottom="20" left="24"/></padding>
  <children>
   <Label text="View Optical Prescriptions"><font><Font name="System Bold" size="26"/></font></Label>
   <HBox spacing="10">
    <children>
     <TextField fx:id="searchTextField" promptText="Prescription ID or patient name" prefWidth="340"/>
     <Button text="Search" onAction="#searchButton"/>
     <Button text="Show All" onAction="#showAllButton"/>
     <Button text="Back" onAction="#backButton"/>
    </children>
   </HBox>
   <TableView fx:id="prescriptionTableView" prefHeight="380">
    <columns>
     <TableColumn fx:id="prescriptionIdColumn" text="Prescription ID" prefWidth="130"/>
     <TableColumn fx:id="patientIdColumn" text="Patient ID" prefWidth="100"/>
     <TableColumn fx:id="patientNameColumn" text="Patient Name" prefWidth="170"/>
     <TableColumn fx:id="doctorNameColumn" text="Doctor" prefWidth="160"/>
     <TableColumn fx:id="prescriptionDateColumn" text="Date" prefWidth="120"/>
     <TableColumn fx:id="statusColumn" text="Status" prefWidth="140"/>
    </columns>
   </TableView>
   <GridPane hgap="10" vgap="10">
    <children>
     <Label text="Right Eye" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
     <TextField fx:id="rightEyePowerTextField" editable="false" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
     <Label text="Left Eye" GridPane.columnIndex="2" GridPane.rowIndex="0"/>
     <TextField fx:id="leftEyePowerTextField" editable="false" GridPane.columnIndex="3" GridPane.rowIndex="0"/>
     <Label text="Doctor Notes" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
     <TextArea fx:id="doctorNotesTextArea" editable="false" prefHeight="70" GridPane.columnIndex="1" GridPane.rowIndex="1" GridPane.columnSpan="3"/>
    </children>
   </GridPane>
   <Label fx:id="statusLabel" text="Ready" style="-fx-border-color: black; -fx-padding: 8;"/>
  </children>
 </VBox></children>
</AnchorPane>