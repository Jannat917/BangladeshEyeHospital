<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="650.0" prefWidth="900.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.summer26.section1.group5.bangladesheyehospital.mdhossain.AssignDoctorsController">
    <children>
        <Label layoutX="280.0" layoutY="14.0" prefHeight="31.0" prefWidth="345.0" text="Bangladesh Eye Hospital">
            <font>
                <Font size="26.0" />
            </font>
        </Label>

        <Label layoutX="300.0" layoutY="64.0" text="Assign Doctors">
            <font>
                <Font size="22.0" />
            </font>
        </Label>

        <Label layoutX="200.0" layoutY="150.0" text="Patient ID:" />
        <TextField fx:id="patientIdField" layoutX="400.0" layoutY="145.0" prefWidth="200.0" promptText="Enter Patient ID (e.g., 101)" />

        <Label layoutX="200.0" layoutY="210.0" text="Select Doctor:" />
        <ComboBox fx:id="doctorCombo" layoutX="400.0" layoutY="205.0" prefWidth="300.0" promptText="Select doctor" />

        <Button layoutX="400.0" layoutY="280.0" onAction="#assignDoctor" prefHeight="40.0" prefWidth="150.0" text="Assign" />

        <Label fx:id="statusLabel" layoutX="200.0" layoutY="350.0" prefWidth="550.0" style="-fx-text-fill: #f39c12; -fx-font-size: 13px;" wrapText="true" />

        <Button fx:id="printBtn" disable="true" layoutX="400.0" layoutY="450.0" onAction="#printAssignment" prefHeight="40.0" prefWidth="150.0" text="Print Slip" />

        <Label layoutX="200.0" layoutY="530.0" style="-fx-text-fill: #7f8c8d; -fx-font-size: 12px;" text="Available Patients: 101 - Jahirul Islam | 102 - Fatema Begum | 103 - Rahim Khan" />

        <Label layoutX="200.0" layoutY="550.0" style="-fx-text-fill: #7f8c8d; -fx-font-size: 12px;" text="Doctors: 1 - Dr. Rahman, 2 - Dr. Sultana, 3 - Dr. Islam" />

        <Button layoutX="518.0" layoutY="567.0" onAction="#backButton" prefHeight="40.0" prefWidth="200.0" text="Back to Dashboard" />
    </children>
</AnchorPane>
