<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="600.0" prefWidth="900.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.summer26.section1.group5.bangladesheyehospital.mdhossain.RecordExitController">
    <children>
        <Label layoutX="280.0" layoutY="14.0" prefHeight="31.0" prefWidth="345.0" text="Bangladesh Eye Hospital">
            <font>
                <Font size="26.0" />
            </font>
        </Label>

        <Label layoutX="300.0" layoutY="64.0" text="Record Exit">
            <font>
                <Font size="22.0" />
            </font>
        </Label>

        <Label layoutX="200.0" layoutY="150.0" text="Enter Patient/Visitor ID:" />
        <TextField fx:id="exitIdField" layoutX="420.0" layoutY="145.0" prefWidth="250.0" promptText="Enter ID (e.g., 101 or V-123456)" />

        <Button layoutX="400.0" layoutY="220.0" onAction="#recordExit" prefHeight="40.0" prefWidth="150.0" text="Record Exit" />

        <Label fx:id="statusLabel" layoutX="200.0" layoutY="300.0" prefWidth="500.0" style="-fx-text-fill: #f39c12;" />

        <Label fx:id="exitTimeLabel" layoutX="200.0" layoutY="340.0" prefWidth="400.0" />

        <Button layoutX="350.0" layoutY="330.0" onAction="#backButton" prefHeight="40.0" prefWidth="200.0" text="Back to Dashboard" />
    </children>
</AnchorPane>
