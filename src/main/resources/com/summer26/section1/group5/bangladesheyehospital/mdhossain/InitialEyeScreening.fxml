<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.summer26.section1.group5.bangladesheyehospital.mdhossain.InitialEyeScreeningController"
            prefHeight="720.0" prefWidth="1200.0"
            style="-fx-background-color: #f4f7fb;">

    <top>
        <HBox spacing="12.0" alignment="CENTER_LEFT"
              style="-fx-background-color: white; -fx-border-color: #d9e2ec; -fx-border-width: 0 0 1 0;">
            <padding>
                <Insets top="18" right="24" bottom="18" left="24"/>
            </padding>

            <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                <Label text="Initial Eye Screening"
                       style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #102a43;"/>
                <Label text="Record eyesight score, blood pressure, and screening notes."
                       style="-fx-font-size: 13px; -fx-text-fill: #627d98;"/>
            </VBox>

            <Button text="Back to Dashboard"
                    onAction="#goBackDashboard"
                    style="-fx-background-color: #334e68; -fx-text-fill: white; -fx-font-weight: bold;"/>
        </HBox>
    </top>

    <center>
        <HBox spacing="18.0">
            <padding>
                <Insets top="24" right="24" bottom="24" left="24"/>
            </padding>

            <VBox spacing="14.0" prefWidth="390.0"
                  style="-fx-background-color: white; -fx-background-radius: 16; -fx-border-radius: 16; -fx-border-color: #e3e8ee;">
                <padding>
                    <Insets top="18" right="18" bottom="18" left="18"/>
                </padding>

                <Label text="Patient Screening Form"
                       style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #102a43;"/>
                <Separator/>

                <Label text="Patient ID"/>
                <TextField fx:id="patientIdField" promptText="Enter patient ID"/>

                <Label text="Patient Name"/>
                <TextField fx:id="patientNameField" promptText="Enter patient name"/>

                <Label text="Age"/>
                <TextField fx:id="ageField" promptText="Enter age"/>

                <Label text="Eye Screening Result"/>
                <ComboBox fx:id="eyeResultBox" prefWidth="Infinity" promptText="Select result"/>

                <Label text="Blood Pressure"/>
                <TextField fx:id="bpField" promptText="Example: 120/80"/>

                <Label text="Remarks"/>
                <TextArea fx:id="remarksArea" promptText="Short screening notes" prefRowCount="4" wrapText="true"/>

                <HBox spacing="10.0">
                    <Button text="Save" onAction="#handleSave" maxWidth="Infinity" HBox.hgrow="ALWAYS"
                            style="-fx-background-color: #2f855a; -fx-text-fill: white; -fx-font-weight: bold;"/>
                    <Button text="Search" onAction="#handleSearch" maxWidth="Infinity" HBox.hgrow="ALWAYS"
                            style="-fx-background-color: #2b6cb0; -fx-text-fill: white; -fx-font-weight: bold;"/>
                </HBox>

                <HBox spacing="10.0">
                    <Button text="Update" onAction="#handleUpdate" maxWidth="Infinity" HBox.hgrow="ALWAYS"
                            style="-fx-background-color: #d69e2e; -fx-text-fill: white; -fx-font-weight: bold;"/>
                    <Button text="Clear" onAction="#handleClear" maxWidth="Infinity" HBox.hgrow="ALWAYS"
                            style="-fx-background-color: #718096; -fx-text-fill: white; -fx-font-weight: bold;"/>
                </HBox>

                <Label fx:id="statusLabel"
                       text="Ready to screen the patient."
                       wrapText="true"
                       style="-fx-font-size: 13px; -fx-text-fill: #334e68; -fx-padding: 10 0 0 0;"/>
            </VBox>

            <VBox spacing="14.0" HBox.hgrow="ALWAYS"
                  style="-fx-background-color: white; -fx-background-radius: 16; -fx-border-radius: 16; -fx-border-color: #e3e8ee;">
                <padding>
                    <Insets top="18" right="18" bottom="18" left="18"/>
                </padding>

                <Label text="Today’s Screening Records"
                       style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #102a43;"/>
                <Separator/>

                <TableView fx:id="screeningTable" prefHeight="540.0" columnResizePolicy="CONSTRAINED_RESIZE_POLICY">
                    <columns>
                        <TableColumn fx:id="idColumn" text="Patient ID"/>
                        <TableColumn fx:id="nameColumn" text="Name"/>
                        <TableColumn fx:id="ageColumn" text="Age"/>
                        <TableColumn fx:id="eyeColumn" text="Eye Result"/>
                        <TableColumn fx:id="bpColumn" text="Blood Pressure"/>
                        <TableColumn fx:id="remarkColumn" text="Remarks"/>
                    </columns>
                </TableView>
            </VBox>
        </HBox>
    </center>
</BorderPane>
