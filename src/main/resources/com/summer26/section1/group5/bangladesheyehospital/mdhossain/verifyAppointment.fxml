<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="650.0" prefWidth="900.0" xmlns="http://javafx.com/javafx/21.0.6" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.summer26.section1.group5.bangladesheyehospital.mdhossain.VerifyAppointmentController">
    <children>
        <Label layoutX="280.0" layoutY="14.0" prefHeight="31.0" prefWidth="345.0" text="Bangladesh Eye Hospital">
            <font>
                <Font size="26.0" />
            </font>
        </Label>

        <Label layoutX="300.0" layoutY="64.0" text="Verify Appointment">
            <font>
                <Font size="22.0" />
            </font>
        </Label>

        <Label layoutX="200.0" layoutY="150.0" text="Enter Patient/Appointment ID:" />
        <!-- FIXED: Updated prompt text to match actual patient IDs -->
        <TextField fx:id="appointmentIdField" layoutX="420.0" layoutY="145.0" prefWidth="250.0" promptText="Enter ID (e.g., 5000, 5001, 5002)" />

        <Button layoutX="400.0" layoutY="210.0" onAction="#searchAppointment" prefHeight="40.0" prefWidth="150.0" text="Search" />

        <Label fx:id="patientNameLabel" layoutX="200.0" layoutY="280.0" prefWidth="500.0" text="Patient Name: " />
        <Label fx:id="doctorLabel" layoutX="200.0" layoutY="310.0" prefWidth="500.0" text="Doctor: " />
        <Label fx:id="timeSlotLabel" layoutX="200.0" layoutY="340.0" prefWidth="500.0" text="Time Slot: " />

        <Label fx:id="statusLabel" layoutX="200.0" layoutY="390.0" prefWidth="550.0" style="-fx-text-fill: #f39c12; -fx-font-size: 13px;" wrapText="true" />

        <Button fx:id="confirmEntryBtn" layoutX="200.0" layoutY="520.0" onAction="#confirmEntry" prefHeight="40.0" prefWidth="150.0" text="Confirm Entry" disable="true" />
        <Button fx:id="printBtn" layoutX="370.0" layoutY="520.0" onAction="#printSlip" prefHeight="40.0" prefWidth="150.0" text="Print Slip" disable="true" />

        <!-- Updated sample IDs to match actual patient IDs -->
        <Label layoutX="200.0" layoutY="580.0" text="Sample Patient IDs: 5000 - Jahirul Islam | 5001 - Fatema Begum | 5002 - Rahim Khan" style="-fx-text-fill: #7f8c8d; -fx-font-size: 12px;" />

        <Button layoutX="350.0" layoutY="600.0" onAction="#backButton" prefHeight="40.0" prefWidth="200.0" text="Back to Dashboard" />
    </children>
</AnchorPane>