<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>
<AnchorPane prefHeight="600" prefWidth="900" style="-fx-background-color: white;"
 xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
 fx:controller="com.summer26.section1.group5.bangladesheyehospital.mashrif.TrackProductionController">
 <children><VBox spacing="12" prefWidth="900" prefHeight="600">
  <padding><Insets top="20" right="24" bottom="20" left="24"/></padding>
  <children>
   <Label text="Track Production"><font><Font name="System Bold" size="26"/></font></Label>
   <HBox spacing="10"><children>
    <ComboBox fx:id="statusComboBox" promptText="New status" prefWidth="180"/>
    <Button text="Update Status" onAction="#updateStatusButton"/>
    <Button text="Back" onAction="#backButton"/>
   </children></HBox>
   <TableView fx:id="orderTableView" prefHeight="430">
    <columns>
     <TableColumn fx:id="orderIdColumn" text="Order ID" prefWidth="120"/>
     <TableColumn fx:id="patientNameColumn" text="Patient" prefWidth="190"/>
     <TableColumn fx:id="frameNameColumn" text="Frame" prefWidth="190"/>
     <TableColumn fx:id="orderDateColumn" text="Date" prefWidth="130"/>
     <TableColumn fx:id="statusColumn" text="Status" prefWidth="150"/>
    </columns>
   </TableView>
   <Label fx:id="statusLabel" text="Ready" style="-fx-border-color: black; -fx-padding: 8;"/>
  </children>
 </VBox></children>
</AnchorPane>