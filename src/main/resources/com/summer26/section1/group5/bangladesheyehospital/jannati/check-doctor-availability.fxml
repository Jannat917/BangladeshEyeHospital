<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="600.0" prefWidth="850.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.summer26.section1.group5.bangladesheyehospital.jannati.CheckDoctorAvailabilityController">

    <children>

        <Label layoutX="220.0" layoutY="20.0" text="Bangladesh Eye Hospital">
            <font>
                <Font size="28" />
            </font>
        </Label>


        <Label layoutX="270.0" layoutY="65.0" text="Check Doctor Availability">
            <font>
                <Font size="20" />
            </font>
        </Label>


        <!-- Department Search -->

        <Label layoutX="80.0" layoutY="130.0" text="Department" />

        <ComboBox fx:id="departmentComboBox" layoutX="180.0" layoutY="125.0" prefWidth="200.0" />


        <!-- Specialization Search -->

        <Label layoutX="420.0" layoutY="130.0" text="Specialization" />

        <ComboBox fx:id="specializationComboBox" layoutX="530.0" layoutY="125.0" prefWidth="200.0" />


        <Button layoutX="630.0" layoutY="184.0" onAction="#searchButton" prefWidth="100.0" text="Search" />



        <!-- Doctor Table -->

        <TableView fx:id="doctorTableView" layoutX="50.0" layoutY="230.0" prefHeight="220.0" prefWidth="750.0">


            <columns>


                <TableColumn fx:id="doctorNameColumn" prefWidth="130" text="Doctor Name" />


                <TableColumn fx:id="departmentColumn" prefWidth="120" text="Department" />


                <TableColumn fx:id="specializationColumn" prefWidth="140" text="Specialization" />


                <TableColumn fx:id="dayColumn" prefWidth="120" text="Available Days" />


                <TableColumn fx:id="timeColumn" prefWidth="120" text="Available Time" />


                <TableColumn fx:id="availabilityColumn" prefWidth="100" text="Status" />


            </columns>


        </TableView>



        <Label fx:id="messageLabel" layoutX="250.0" layoutY="470.0" prefWidth="350.0" />



        <Button layoutX="250.0" layoutY="520.0" onAction="#clearButton" prefWidth="100.0" text="Clear" />


        <Button layoutX="450.0" layoutY="520.0" onAction="#backButton" prefWidth="120.0" text="Back" />


    </children>

</AnchorPane>
