<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="650.0" prefWidth="900.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.summer26.section1.group5.bangladesheyehospital.jannati.UpdatePatientProgressDoctorController">

    <children>

        <Label layoutX="280.0" layoutY="20.0" text="Update Patient Progress">
            <font>
                <Font size="24.0" />
            </font>
        </Label>

        <!-- Search Section -->

        <Label layoutX="40.0" layoutY="80.0" text="Patient ID" />

        <TextField fx:id="patientIdTextField" layoutX="165.0" layoutY="76.0" prefWidth="180.0" />

        <Button layoutX="415.0" layoutY="76.0" onAction="#searchButton" prefWidth="90.0" text="Search" />

        <!-- Patient Information -->

        <Label layoutX="40.0" layoutY="140.0" text="Patient Name" />

        <TextField fx:id="patientNameTextField" editable="false" layoutX="170.0" layoutY="135.0" prefWidth="250.0" />

        <Label layoutX="460.0" layoutY="140.0" text="Assigned Doctor" />

        <TextField fx:id="doctorTextField" editable="false" layoutX="590.0" layoutY="135.0" prefWidth="230.0" />

        <!-- Current Condition -->

        <Label layoutX="40.0" layoutY="200.0" text="Diagnosis" />

        <TextArea fx:id="diagnosisTextArea" layoutX="170.0" layoutY="195.0" prefHeight="57.0" prefWidth="650.0" />

        <!-- Medication -->

        <Label layoutX="47.0" layoutY="317.0" text="Medication" />

        <TextArea fx:id="medicationTextArea" layoutX="165.0" layoutY="310.0" prefHeight="48.0" prefWidth="650.0" />

        <!-- Doctor Remarks -->

        <Label layoutX="34.0" layoutY="416.0" text="Doctor Remarks" />

        <TextArea fx:id="remarksTextArea" layoutX="170.0" layoutY="409.0" prefHeight="48.0" prefWidth="650.0" />

        <!-- Buttons -->

        <Button layoutX="430.0" layoutY="570.0" onAction="#saveUpdateButton" prefWidth="120.0" text="Save Update" />

        <Button layoutX="570.0" layoutY="570.0" onAction="#clearButton" prefWidth="100.0" text="Clear" />

        <Button layoutX="720.0" layoutY="570.0" onAction="#backButton" prefWidth="100.0" text="Back" />

        <Label fx:id="messageLabel" layoutX="40.0" layoutY="620.0" prefWidth="700.0" />

    </children>

</AnchorPane>
