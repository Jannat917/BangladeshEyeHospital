<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="650.0" prefWidth="900.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.summer26.section1.group5.bangladesheyehospital.mdhossain.RegisterVisitorController">
    <children>
        <Label layoutX="280.0" layoutY="14.0" prefHeight="31.0" prefWidth="345.0" text="Bangladesh Eye Hospital">
            <font>
                <Font size="26.0" />
            </font>
        </Label>

        <Label layoutX="300.0" layoutY="64.0" text="Register Visitor">
            <font>
                <Font size="22.0" />
            </font>
        </Label>

        <!-- Input Fields (No ID field - auto-generated) -->
        <Label layoutX="100.0" layoutY="130.0" text="Visitor Name:" />
        <TextField fx:id="visitorNameField" layoutX="250.0" layoutY="125.0" prefWidth="250.0" promptText="Enter visitor name" />

        <Label layoutX="100.0" layoutY="180.0" text="Phone Number:" />
        <TextField fx:id="phoneField" layoutX="250.0" layoutY="175.0" prefWidth="250.0" promptText="Enter 11 digit phone" />

        <Label layoutX="100.0" layoutY="230.0" text="NID Number:" />
        <TextField fx:id="nidField" layoutX="250.0" layoutY="225.0" prefWidth="250.0" promptText="Enter NID number" />

        <Button layoutX="250.0" layoutY="280.0" onAction="#registerVisitor" prefHeight="40.0" prefWidth="200.0" text="Register Visitor" />
        <Button fx:id="loadSampleBtn" layoutX="470.0" layoutY="280.0" onAction="#loadSampleVisitor" prefHeight="40.0" prefWidth="150.0" text="Load Next Sample" />

        <!-- Display Area -->
        <Label fx:id="visitorIdLabel" layoutX="100.0" layoutY="340.0" prefWidth="300.0" style="-fx-text-fill: #2980b9; -fx-font-weight: bold; -fx-font-size: 14px;" />

        <Label fx:id="statusLabel" layoutX="100.0" layoutY="370.0" prefWidth="750.0" style="-fx-text-fill: #f39c12; -fx-font-size: 13px;" wrapText="true" />

        <!-- Sample Visitors Info -->
        <Label layoutX="100.0" layoutY="480.0" style="-fx-text-fill: #7f8c8d; -fx-font-size: 12px; -fx-font-weight: bold;" text="Sample Visitors (ID auto-generated):" />
        <Label layoutX="100.0" layoutY="500.0" style="-fx-text-fill: #7f8c8d; -fx-font-size: 12px;" text="1. John Doe | Phone: 01712345678 | NID: 1234567890123" />
        <Label layoutX="100.0" layoutY="520.0" style="-fx-text-fill: #7f8c8d; -fx-font-size: 12px;" text="2. Jane Smith | Phone: 01723456789 | NID: 2345678901234" />
        <Label layoutX="100.0" layoutY="540.0" style="-fx-text-fill: #7f8c8d; -fx-font-size: 12px;" text="3. Bob Johnson | Phone: 01734567890 | NID: 3456789012345" />

        <Button layoutX="525.0" layoutY="343.0" onAction="#backButton" prefHeight="35.0" prefWidth="200.0" text="Back to Dashboard" />
      <Label layoutX="49.0" layoutY="326.0" prefHeight="25.0" prefWidth="200.0" text="Visitor Registration Log:" />
      <TextArea fx:id="visitorLogArea" layoutX="161.0" layoutY="388.0" prefHeight="96.0" prefWidth="345.0" />
    </children>
</AnchorPane>
