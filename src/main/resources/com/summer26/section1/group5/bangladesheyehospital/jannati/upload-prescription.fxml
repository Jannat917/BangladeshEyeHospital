<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="700.0" prefWidth="900.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.summer26.section1.group5.bangladesheyehospital.jannati.UploadPrescriptionController">

    <children>

        <!-- Title -->

        <Label layoutX="255.0" layoutY="20.0" text="Bangladesh Eye Hospital">
            <font>
                <Font size="28" />
            </font>
        </Label>

        <Label layoutX="315.0" layoutY="65.0" text="Upload Prescription">
            <font>
                <Font size="20" />
            </font>
        </Label>


        <!-- Existing Patient -->

        <Label layoutX="65.0" layoutY="121.0" text="Patient ID" />

        <TextField fx:id="patientIdTextField" layoutX="175.0" layoutY="116.0" prefWidth="120.0" />

        <Button layoutX="362.0" layoutY="116.0" onAction="#searchButton" prefHeight="26.0" prefWidth="177.0" text="Search" />


        <!-- Patient Information -->

        <Label layoutX="60.0" layoutY="180.0" text="Patient Name" />

        <TextField fx:id="patientNameTextField" layoutX="170.0" layoutY="175.0" prefWidth="220.0" />


        <Label layoutX="430.0" layoutY="180.0" text="Age" />

        <TextField fx:id="ageTextField" layoutX="480.0" layoutY="175.0" prefWidth="70.0" />


        <Label layoutX="590.0" layoutY="180.0" text="Gender" />

        <ComboBox fx:id="genderComboBox" layoutX="660.0" layoutY="175.0" prefWidth="120.0" />


        <Label layoutX="60.0" layoutY="230.0" text="Phone" />

        <TextField fx:id="phoneTextField" layoutX="170.0" layoutY="225.0" prefWidth="220.0" />


        <Label layoutX="430.0" layoutY="230.0" text="Address" />

        <TextField fx:id="addressTextField" layoutX="500.0" layoutY="225.0" prefWidth="280.0" />


        <!-- Treatment Section -->

        <Label layoutX="67.0" layoutY="304.0" text="Diagnosis" />

        <TextArea fx:id="diagnosisTextArea" layoutX="170.0" layoutY="304.0" prefHeight="17.0" prefWidth="610.0" />


        <Label layoutX="61.0" layoutY="464.0" text="Recommendation" />

        <TextArea fx:id="recommendationTextArea" layoutX="175.0" layoutY="458.0" prefHeight="90.0" prefWidth="610.0" />


        <!-- Message -->

        <Label fx:id="messageLabel" layoutX="220.0" layoutY="605.0" prefWidth="450.0" />


        <!-- Buttons -->

        <Button layoutX="250.0" layoutY="579.0" onAction="#saveButton" prefWidth="130.0" text="Save Prescription" />

        <Button layoutX="425.0" layoutY="579.0" onAction="#clearButton" prefWidth="100.0" text="Clear" />

        <Button layoutX="649.0" layoutY="639.0" onAction="#backButton" prefWidth="100.0" text="Back" />
      <Label layoutX="66.0" layoutY="267.0" text="Disease" />
      <TextField fx:id="diseaseTextField" layoutX="170.0" layoutY="254.0" prefWidth="220.0" />
      <Label layoutX="67.0" layoutY="351.0" text="Eye Power " />
      <TextArea fx:id="eyePowerTextArea" layoutX="171.0" layoutY="351.0" prefHeight="17.0" prefWidth="610.0" />
      <Label layoutX="61.0" layoutY="425.0" text="Medication" />
      <TextArea fx:id="medicationTextArea" layoutX="175.0" layoutY="405.0" prefHeight="17.0" prefWidth="610.0" />

    </children>

</AnchorPane>
