<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="600.0" prefWidth="850.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.summer26.section1.group5.bangladesheyehospital.jannati.ConsultationHistoryDoctorController">

    <children>

        <Label layoutX="240.0" layoutY="20.0" text="Previous Consultation History">
            <font>
                <Font size="24.0" />
            </font>
        </Label>

        <!-- Search -->

        <Label layoutX="40.0" layoutY="80.0" text="Patient ID" />

        <TextField fx:id="patientIdTextField" layoutX="130.0" layoutY="75.0" prefWidth="180.0" />

        <Button layoutX="446.0" layoutY="75.0" onAction="#searchButton" prefWidth="90.0" text="Search" />

        <!-- Patient Name -->

        <Label layoutX="40.0" layoutY="130.0" text="Patient Name" />

        <TextField fx:id="patientNameTextField" editable="false" layoutX="130.0" layoutY="125.0" prefWidth="250.0" />

        <!-- Consultation History -->

        <Label layoutX="40.0" layoutY="175.0" text="Consultation History" />

        <TextArea fx:id="historyTextArea" editable="false" layoutX="40.0" layoutY="200.0" prefHeight="220.0" prefWidth="770.0" wrapText="true" />

        <Button layoutX="446.0" layoutY="126.0" onAction="#clearButton" prefWidth="90.0" text="Clear" />

        <Button layoutX="695.0" layoutY="535.0" onAction="#backButton" prefHeight="26.0" prefWidth="111.0" text="Back" />

        <Label fx:id="messageLabel" layoutX="40.0" layoutY="575.0" prefWidth="700.0" />

    </children>

</AnchorPane>
