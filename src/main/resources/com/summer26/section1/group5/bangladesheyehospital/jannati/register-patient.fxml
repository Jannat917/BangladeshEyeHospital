<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="650.0" prefWidth="800.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.summer26.section1.group5.bangladesheyehospital.jannati.RegisterPatientController">

    <children>

        <Label layoutX="245.0" layoutY="20.0" text="Register New Patient">
            <font>
                <Font size="28.0" />
            </font>
        </Label>

        <!-- Patient Name -->
        <Label layoutX="120.0" layoutY="90.0" text="Patient Name" />
        <TextField fx:id="patientNameTextField" layoutX="280.0" layoutY="85.0" prefWidth="250.0" promptText="Enter patient name" />

        <!-- Age -->
        <Label layoutX="120.0" layoutY="135.0" text="Age" />
        <TextField fx:id="ageTextField" layoutX="280.0" layoutY="130.0" prefWidth="250.0" promptText="Enter age" />

        <!-- Gender -->
        <Label layoutX="120.0" layoutY="180.0" text="Gender" />
        <ComboBox fx:id="genderComboBox" layoutX="280.0" layoutY="175.0" prefWidth="250.0" />

        <!-- Phone -->
        <Label layoutX="120.0" layoutY="225.0" text="Phone Number" />
        <TextField fx:id="phoneNumberTextField" layoutX="280.0" layoutY="220.0" prefWidth="250.0" promptText="Enter phone number" />

        <!-- Address -->
        <Label layoutX="120.0" layoutY="270.0" text="Address" />
        <TextField fx:id="addressTextField" layoutX="280.0" layoutY="265.0" prefWidth="250.0" promptText="Enter address" />

        <!-- Buttons -->
        <Button layoutX="260.0" layoutY="345.0" onAction="#confirmButton" prefHeight="35.0" prefWidth="100.0" text="Confirm" />

        <Button layoutX="405.0" layoutY="345.0" onAction="#clearButton" prefHeight="35.0" prefWidth="100.0" text="Clear" />

        <Button layoutX="496.0" layoutY="573.0" onAction="#backButton" prefHeight="49.0" prefWidth="140.0" text="Back to Dashboard" />

        <!-- Message -->
        <Label fx:id="messageLabel" layoutX="105.0" layoutY="502.0" prefHeight="17.0" prefWidth="524.0" />

    </children>

</AnchorPane>
