<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="600.0" prefWidth="900.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.summer26.section1.group5.bangladesheyehospital.jannati.PatientRecordDoctorController">

    <children>

        <Label layoutX="270.0" layoutY="20.0" text="View Patient Records">
            <font>
                <Font size="24" />
            </font>
        </Label>

        <Label layoutX="35.0" layoutY="75.0" text="Patient ID" />

        <TextField fx:id="patientIdTextField" layoutX="110.0" layoutY="70.0" prefWidth="120" />

        <Label layoutX="255.0" layoutY="75.0" text="Patient Name" />

        <TextField fx:id="patientNameTextField" layoutX="360.0" layoutY="70.0" prefWidth="170" />

        <Button layoutX="560.0" layoutY="69.0" onAction="#searchButton" text="Search" />

        <Button layoutX="650.0" layoutY="69.0" onAction="#showAllButton" text="Show All" />

        <TableView fx:id="patientTableView" layoutX="30.0" layoutY="120.0" prefHeight="370.0" prefWidth="840.0">

            <columns>

                <TableColumn fx:id="patientIdColumn" prefWidth="90" text="Patient ID" />

                <TableColumn fx:id="patientNameColumn" prefWidth="180" text="Patient Name" />

                <TableColumn fx:id="ageColumn" prefWidth="70" text="Age" />

                <TableColumn fx:id="genderColumn" prefWidth="90" text="Gender" />

                <TableColumn fx:id="phoneColumn" prefWidth="150" text="Phone" />

                <TableColumn fx:id="doctorColumn" prefWidth="128.0" text="Assigned Doctor" />

                <TableColumn fx:id="appointmentColumn" prefWidth="162.0" text="Appointment" />

            </columns>

        </TableView>

        <Button layoutX="755.0" layoutY="70.0" onAction="#viewHistoryButton" prefHeight="26.0" prefWidth="120.0" text="View Full History" />

        <Button layoutX="715.0" layoutY="533.0" onAction="#backButton" prefHeight="26.0" prefWidth="101.0" text="Back" />

        <Label fx:id="messageLabel" layoutX="35.0" layoutY="555.0" prefWidth="400" />

    </children>

</AnchorPane>
