<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="600.0" prefWidth="900.0" xmlns="http://javafx.com/javafx/21.0.6" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.summer26.section1.group5.bangladesheyehospital.mdhossain.DoctorQueuesController">
    <children>
        <Label layoutX="280.0" layoutY="14.0" prefHeight="31.0" prefWidth="345.0" text="Bangladesh Eye Hospital">
            <font><Font size="26.0" /></font>
        </Label>
        <Label layoutX="300.0" layoutY="64.0" text="Manage Doctor Queues">
            <font><Font size="22.0" /></font>
        </Label>
        <Label layoutX="100.0" layoutY="130.0" text="Doctors:" />
        <ListView fx:id="doctorListView" layoutX="100.0" layoutY="160.0" prefHeight="200.0" prefWidth="250.0" />
        <Button layoutX="100.0" layoutY="380.0" onAction="#viewQueue" prefHeight="35.0" prefWidth="150.0" text="View Queue" />
        <Label layoutX="500.0" layoutY="130.0" text="Queue:" />
        <ListView fx:id="queueListView" layoutX="500.0" layoutY="160.0" prefHeight="200.0" prefWidth="300.0" />
        <Button layoutX="500.0" layoutY="380.0" onAction="#callNext" prefHeight="35.0" prefWidth="150.0" text="Call Next Patient" />
        <Label fx:id="statusLabel" layoutX="100.0" layoutY="450.0" prefWidth="700.0" style="-fx-text-fill: #f39c12; -fx-font-size: 13px;" />
        <Button layoutX="350.0" layoutY="540.0" onAction="#backButton" prefHeight="40.0" prefWidth="200.0" text="Back to Dashboard" />
    </children>
</AnchorPane>