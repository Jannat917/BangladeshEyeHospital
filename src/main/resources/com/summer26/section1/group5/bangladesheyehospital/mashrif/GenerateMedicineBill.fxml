<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="720.0" prefWidth="1050.0"
            style="-fx-background-color: white;"
            xmlns="http://javafx.com/javafx/21.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.summer26.section1.group5.bangladesheyehospital.mashrif.GenerateMedicineBillController">

    <children>
        <VBox prefHeight="720.0" prefWidth="1050.0" spacing="15.0">
            <padding>
                <Insets bottom="22.0" left="28.0" right="28.0" top="22.0"/>
            </padding>

            <children>
                <Label text="Generate Medicine Bill">
                    <font>
                        <Font name="System Bold" size="28.0"/>
                    </font>
                </Label>

                <GridPane hgap="12.0" vgap="12.0">
                    <children>
                        <Label text="Prescription" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                        <ComboBox fx:id="prescriptionComboBox"
                                  promptText="Select prescription"
                                  prefWidth="260.0"
                                  GridPane.columnIndex="1" GridPane.rowIndex="0"/>

                        <Label text="Patient Name" GridPane.columnIndex="2" GridPane.rowIndex="0"/>
                        <TextField fx:id="patientNameTextField"
                                   editable="false"
                                   prefWidth="230.0"
                                   GridPane.columnIndex="3" GridPane.rowIndex="0"/>

                        <Label text="Discount" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                        <TextField fx:id="discountTextField"
                                   promptText="0"
                                   GridPane.columnIndex="1" GridPane.rowIndex="1"/>

                        <Label text="Paid Amount" GridPane.columnIndex="2" GridPane.rowIndex="1"/>
                        <TextField fx:id="paidAmountTextField"
                                   promptText="Enter amount"
                                   GridPane.columnIndex="3" GridPane.rowIndex="1"/>
                    </children>
                </GridPane>

                <TableView fx:id="billTableView" prefHeight="300.0">
                    <columns>
                        <TableColumn fx:id="medicineCodeColumn" prefWidth="130.0" text="Medicine Code"/>
                        <TableColumn fx:id="medicineNameColumn" prefWidth="220.0" text="Medicine Name"/>
                        <TableColumn fx:id="quantityColumn" prefWidth="120.0" text="Quantity"/>
                        <TableColumn fx:id="unitPriceColumn" prefWidth="130.0" text="Unit Price"/>
                        <TableColumn fx:id="subtotalColumn" prefWidth="150.0" text="Subtotal"/>
                    </columns>
                </TableView>

                <GridPane hgap="12.0" vgap="10.0">
                    <children>
                        <Label text="Subtotal" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                        <Label fx:id="subtotalLabel"
                               text="0.00"
                               GridPane.columnIndex="1" GridPane.rowIndex="0"/>

                        <Label text="Discount" GridPane.columnIndex="2" GridPane.rowIndex="0"/>
                        <Label fx:id="discountLabel"
                               text="0.00"
                               GridPane.columnIndex="3" GridPane.rowIndex="0"/>

                        <Label text="Total" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                        <Label fx:id="totalLabel"
                               text="0.00"
                               GridPane.columnIndex="1" GridPane.rowIndex="1"/>

                        <Label text="Change" GridPane.columnIndex="2" GridPane.rowIndex="1"/>
                        <Label fx:id="changeLabel"
                               text="0.00"
                               GridPane.columnIndex="3" GridPane.rowIndex="1"/>
                    </children>
                </GridPane>

                <TextArea fx:id="billPreviewTextArea"
                          editable="false"
                          prefHeight="130.0"
                          promptText="Bill preview will appear here."/>

                <HBox spacing="10.0">
                    <children>
                        <Button text="Calculate Bill"
                                onAction="#calculateBillButton"
                                prefWidth="130.0"
                                style="-fx-background-color: black; -fx-text-fill: white;"/>

                        <Button text="Generate Bill"
                                onAction="#generateBillButton"
                                prefWidth="130.0"
                                style="-fx-background-color: black; -fx-text-fill: white;"/>

                        <Button text="Clear"
                                onAction="#clearButton"
                                prefWidth="100.0"
                                style="-fx-background-color: white; -fx-text-fill: black; -fx-border-color: black;"/>

                        <Button text="Back"
                                onAction="#backButton"
                                prefWidth="100.0"
                                style="-fx-background-color: white; -fx-text-fill: black; -fx-border-color: black;"/>
                    </children>
                </HBox>

                <Label fx:id="statusLabel"
                       text="Ready"
                       style="-fx-background-color: white; -fx-border-color: black; -fx-padding: 10;"/>
            </children>
        </VBox>
    </children>
</AnchorPane>
