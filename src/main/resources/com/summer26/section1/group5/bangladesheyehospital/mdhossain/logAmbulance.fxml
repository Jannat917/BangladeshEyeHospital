<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="600.0" prefWidth="900.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.summer26.section1.group5.bangladesheyehospital.mdhossain.LogAmbulanceController">
    <children>
        <Label layoutX="280.0" layoutY="14.0" prefHeight="31.0" prefWidth="345.0" text="Bangladesh Eye Hospital">
            <font><Font size="26.0" /></font>
        </Label>
        <Label layoutX="300.0" layoutY="64.0" text="Log Ambulance">
            <font><Font size="22.0" /></font>
        </Label>

        <Label layoutX="200.0" layoutY="150.0" text="Ambulance Number:" />
        <TextField fx:id="ambulanceNumberField" layoutX="400.0" layoutY="145.0" prefWidth="250.0" promptText="e.g., ABC-123" />

        <Button layoutX="400.0" layoutY="210.0" onAction="#logAmbulance" text="Log Ambulance" />

        <Label fx:id="statusLabel" layoutX="200.0" layoutY="280.0" prefWidth="500.0" style="-fx-text-fill: #f39c12;" />
        <Label fx:id="timeLabel" layoutX="200.0" layoutY="320.0" prefWidth="400.0" />

        <Button layoutX="350.0" layoutY="540.0" onAction="#backButton" text="Back to Dashboard" />
    </children>
</AnchorPane>
