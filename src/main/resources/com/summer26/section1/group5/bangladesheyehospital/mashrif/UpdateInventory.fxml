<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="700.0" prefWidth="1050.0"
            style="-fx-background-color: white;"
            xmlns="http://javafx.com/javafx/21.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.summer26.section1.group5.bangladesheyehospital.mashrif.UpdateInventoryController">

    <children>
        <VBox prefHeight="700.0" prefWidth="1050.0" spacing="16.0">
            <padding>
                <Insets bottom="22.0" left="28.0" right="28.0" top="22.0"/>
            </padding>

            <children>
                <Label text="Update Medicine Inventory" textFill="BLACK">
                    <font>
                        <Font name="System Bold" size="28.0"/>
                    </font>
                </Label>

                <GridPane hgap="12.0" vgap="12.0">
                    <children>
                        <Label text="Medicine Code" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                        <TextField fx:id="medicineCodeTextField"
                                   promptText="MED-001"
                                   GridPane.columnIndex="1" GridPane.rowIndex="0"/>

                        <Label text="Medicine Name" GridPane.columnIndex="2" GridPane.rowIndex="0"/>
                        <TextField fx:id="medicineNameTextField"
                                   promptText="Medicine name"
                                   GridPane.columnIndex="3" GridPane.rowIndex="0"/>

                        <Label text="Category" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                        <TextField fx:id="categoryTextField"
                                   promptText="Eye Drop"
                                   GridPane.columnIndex="1" GridPane.rowIndex="1"/>

                        <Label text="Batch Number" GridPane.columnIndex="2" GridPane.rowIndex="1"/>
                        <TextField fx:id="batchNumberTextField"
                                   promptText="BATCH-001"
                                   GridPane.columnIndex="3" GridPane.rowIndex="1"/>

                        <Label text="Stock Quantity" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                        <TextField fx:id="stockQuantityTextField"
                                   promptText="50"
                                   GridPane.columnIndex="1" GridPane.rowIndex="2"/>

                        <Label text="Reorder Level" GridPane.columnIndex="2" GridPane.rowIndex="2"/>
                        <TextField fx:id="reorderLevelTextField"
                                   promptText="10"
                                   GridPane.columnIndex="3" GridPane.rowIndex="2"/>

                        <Label text="Unit Price" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
                        <TextField fx:id="unitPriceTextField"
                                   promptText="250"
                                   GridPane.columnIndex="1" GridPane.rowIndex="3"/>

                        <Label text="Expiry Date" GridPane.columnIndex="2" GridPane.rowIndex="3"/>
                        <DatePicker fx:id="expiryDatePicker"
                                    GridPane.columnIndex="3" GridPane.rowIndex="3"/>

                        <Label text="Supplier Name" GridPane.columnIndex="0" GridPane.rowIndex="4"/>
                        <TextField fx:id="supplierNameTextField"
                                   promptText="Supplier"
                                   GridPane.columnIndex="1" GridPane.rowIndex="4"/>
                    </children>
                </GridPane>

                <HBox spacing="10.0">
                    <children>
                        <Button text="Add Medicine"
                                onAction="#addMedicineButton"
                                prefWidth="130.0"
                                style="-fx-background-color: black; -fx-text-fill: white;"/>

                        <Button text="Update Selected"
                                onAction="#updateSelectedButton"
                                prefWidth="130.0"
                                style="-fx-background-color: white; -fx-text-fill: black; -fx-border-color: black;"/>

                        <Button text="Clear"
                                onAction="#clearButton"
                                prefWidth="100.0"
                                style="-fx-background-color: white; -fx-text-fill: black; -fx-border-color: black;"/>

                        <Button text="Back"
                                onAction="#backButton"
                                prefWidth="100.0"
                                style="-fx-background-color: white; -fx-text-fill: black; -fx-border-color: black;"/>
                    </children>
                </HBox>

                <TableView fx:id="medicineTableView" prefHeight="350.0">
                    <columns>
                        <TableColumn fx:id="medicineCodeColumn" prefWidth="110.0" text="Code"/>
                        <TableColumn fx:id="medicineNameColumn" prefWidth="160.0" text="Name"/>
                        <TableColumn fx:id="categoryColumn" prefWidth="110.0" text="Category"/>
                        <TableColumn fx:id="batchNumberColumn" prefWidth="100.0" text="Batch"/>
                        <TableColumn fx:id="stockQuantityColumn" prefWidth="90.0" text="Stock"/>
                        <TableColumn fx:id="reorderLevelColumn" prefWidth="100.0" text="Reorder"/>
                        <TableColumn fx:id="unitPriceColumn" prefWidth="100.0" text="Price"/>
                        <TableColumn fx:id="expiryDateColumn" prefWidth="115.0" text="Expiry"/>
                        <TableColumn fx:id="supplierNameColumn" prefWidth="135.0" text="Supplier"/>
                    </columns>
                </TableView>

                <Label fx:id="statusLabel"
                       text="Ready"
                       style="-fx-background-color: white; -fx-border-color: black; -fx-padding: 10;"
                       textFill="BLACK"/>
            </children>
        </VBox>
    </children>
</AnchorPane>
