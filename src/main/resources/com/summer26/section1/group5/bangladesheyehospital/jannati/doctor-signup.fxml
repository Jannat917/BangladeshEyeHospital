      <ComboBox fx:id="availabilityOnCombobox" layoutX="275.0" layoutY="436.0" prefWidth="150.0" />
      <Label layoutX="149.0" layoutY="441.0" prefHeight="17.0" prefWidth="91.0" text="Availability on : " />

