        <TextField fx:id="userIdTextField" layoutX="277.0" layoutY="115.0" prefWidth="220.0" promptText="Enter User ID" />

        <Label layoutX="150.0" layoutY="161.0" text="Name" />

        <TextField fx:id="nameTextField" layoutX="279.0" layoutY="157.0" prefWidth="220.0" promptText="Enter Name" />

