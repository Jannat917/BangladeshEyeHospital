        <Label layoutX="142.0" layoutY="407.0" prefHeight="17.0" prefWidth="91.0" text="Available Time  : " />
        <CheckBox fx:id="sat" layoutX="279.0" layoutY="343.0" mnemonicParsing="false" text="Saturday" />
        <CheckBox fx:id="sun" layoutX="367.0" layoutY="343.0" mnemonicParsing="false" text="Sunday" />
        <CheckBox fx:id="mon" layoutX="450.0" layoutY="343.0" mnemonicParsing="false" text="Monday" />
        <CheckBox fx:id="tues" layoutX="530.0" layoutY="343.0" mnemonicParsing="false" text="Tuesday" />
        <CheckBox fx:id="wed" layoutX="284.0" layoutY="373.0" mnemonicParsing="false" text="Wednesday" />
        <CheckBox fx:id="thurs" layoutX="397.0" layoutY="373.0" mnemonicParsing="false" text="Thurday" />
