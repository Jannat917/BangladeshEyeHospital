<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="600.0" prefWidth="900.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.summer26.section1.group5.bangladesheyehospital.mdhossain.ShiftHandoverController">
    <children>
        <Label layoutX="280.0" layoutY="14.0" prefHeight="31.0" prefWidth="345.0" text="Bangladesh Eye Hospital">
            <font><Font size="26.0" /></font>
        </Label>
        <Label layoutX="300.0" layoutY="64.0" text="Shift Handover">
            <font><Font size="22.0" /></font>
        </Label>

        <Label layoutX="200.0" layoutY="150.0" text="Next Officer ID:" />
        <TextField fx:id="officerIdField" layoutX="400.0" layoutY="145.0" prefWidth="250.0" promptText="Enter Officer ID" />

        <Label layoutX="200.0" layoutY="200.0" text="Handover Notes:" />
        <TextArea fx:id="notesArea" layoutX="200.0" layoutY="235.0" prefWidth="500.0" prefHeight="150.0" promptText="Notes..." />

        <Button layoutX="400.0" layoutY="410.0" onAction="#completeHandover" text="Complete Handover" />

        <Label fx:id="statusLabel" layoutX="200.0" layoutY="480.0" prefWidth="500.0" style="-fx-text-fill: #f39c12;" />

        <Button layoutX="350.0" layoutY="540.0" onAction="#backButton" text="Back to Dashboard" />
    </children>
</AnchorPane>
