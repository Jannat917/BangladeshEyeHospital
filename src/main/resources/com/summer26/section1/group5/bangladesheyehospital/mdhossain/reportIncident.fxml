<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="700.0" prefWidth="900.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.summer26.section1.group5.bangladesheyehospital.mdhossain.ReportIncidentController">
    <children>
        <Label layoutX="280.0" layoutY="14.0" prefHeight="31.0" prefWidth="345.0" text="Bangladesh Eye Hospital">
            <font><Font size="26.0" /></font>
        </Label>

        <Label layoutX="300.0" layoutY="64.0" text="Report Incident">
            <font><Font size="22.0" /></font>
        </Label>

        <Label layoutX="200.0" layoutY="150.0" text="Incident Type:" />
        <ComboBox fx:id="incidentTypeCombo" layoutX="400.0" layoutY="145.0" prefWidth="250.0" promptText="Select incident type" />

        <Label layoutX="200.0" layoutY="210.0" text="Select Patient:" />
        <ComboBox fx:id="patientCombo" layoutX="400.0" layoutY="205.0" prefWidth="250.0" promptText="Select patient" />

        <Label layoutX="200.0" layoutY="270.0" text="Incident Details:" />
        <TextArea fx:id="incidentDetailsArea" layoutX="200.0" layoutY="305.0" prefHeight="150.0" prefWidth="500.0" promptText="Describe the incident in detail..." />

        <Button layoutX="400.0" layoutY="480.0" onAction="#submitIncident" prefHeight="40.0" prefWidth="150.0" text="Submit Report" />

        <Label fx:id="statusLabel" layoutX="200.0" layoutY="540.0" prefWidth="550.0" style="-fx-text-fill: #f39c12; -fx-font-size: 13px;" wrapText="true" />

        <!-- Sample Info -->
        <Label layoutX="200.0" layoutY="517.0" prefHeight="40.0" prefWidth="105.0" style="-fx-text-fill: #7f8c8d; -fx-font-size: 12px; -fx-font-weight: bold;" text="Available Patients:" />
        <Label layoutX="200.0" layoutY="549.0" prefHeight="70.0" prefWidth="358.0" style="-fx-text-fill: #7f8c8d; -fx-font-size: 12px;" text="12345 - Jahirul Islam | 23456 - Fatema Begum | 34567 - Rahim Khan" />

        <Button layoutX="595.0" layoutY="500.0" onAction="#backButton" prefHeight="40.0" prefWidth="128.0" text="Back to Dashboard" />
    </children>
</AnchorPane>
