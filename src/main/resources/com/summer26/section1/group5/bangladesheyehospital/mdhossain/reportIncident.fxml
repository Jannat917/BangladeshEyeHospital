<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="600.0" prefWidth="900.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.summer26.section1.group5.bangladesheyehospital.mdhossain.ReportIncidentController">

    <children>
        <Label layoutX="280.0" layoutY="14.0" prefHeight="31.0" prefWidth="345.0" text="Bangladesh Eye Hospital">
            <font>
                <Font size="26.0" />
            </font>
        </Label>

        <Label layoutX="300.0" layoutY="64.0" text="Report Incident">
            <font>
                <Font size="22.0" />
            </font>
        </Label>

        <Label layoutX="200.0" layoutY="150.0" text="Incident Type:" />
        <ComboBox fx:id="incidentTypeCombo" layoutX="400.0" layoutY="145.0" prefWidth="250.0" promptText="Select incident type" />

        <Label layoutX="200.0" layoutY="210.0" text="Incident Details:" />
        <TextArea fx:id="incidentDetailsArea" layoutX="200.0" layoutY="245.0" prefWidth="500.0" prefHeight="150.0" promptText="Describe the incident..." />

        <Button layoutX="400.0" layoutY="420.0" onAction="#submitIncident" prefHeight="40.0" prefWidth="150.0" text="Submit Report" />

        <Label fx:id="statusLabel" layoutX="200.0" layoutY="490.0" prefWidth="500.0" style="-fx-text-fill: #f39c12;" />

        <Button layoutX="350.0" layoutY="540.0" onAction="#backButton" prefHeight="40.0" prefWidth="200.0" text="Back to Dashboard" />
    </children>

</AnchorPane>
