<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="650.0" prefWidth="1000.0"
            style="-fx-background-color: white;"
            xmlns="http://javafx.com/javafx/21.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.summer26.section1.group5.bangladesheyehospital.mashrif.CheckMedicineStockController">

    <children>
        <VBox prefHeight="650.0" prefWidth="1000.0" spacing="18.0">
            <padding>
                <Insets bottom="24.0" left="28.0" right="28.0" top="24.0"/>
            </padding>

            <children>
                <Label text="Check Medicine Stock" textFill="BLACK">
                    <font>
                        <Font name="System Bold" size="28.0"/>
                    </font>
                </Label>

                <Label text="Search medicine by code or name and view current stock information."
                       textFill="BLACK"/>

                <HBox spacing="10.0">
                    <children>
                        <TextField fx:id="searchTextField"
                                   promptText="Enter medicine code or name"
                                   prefWidth="320.0"/>

                        <Button text="Search"
                                onAction="#searchMedicineButton"
                                prefWidth="100.0"
                                style="-fx-background-color: black; -fx-text-fill: white;"/>

                        <Button text="Show All"
                                onAction="#showAllButton"
                                prefWidth="100.0"
                                style="-fx-background-color: white; -fx-text-fill: black; -fx-border-color: black;"/>

                        <Button text="Back"
                                onAction="#backButton"
                                prefWidth="100.0"
                                style="-fx-background-color: white; -fx-text-fill: black; -fx-border-color: black;"/>
                    </children>
                </HBox>

                <TableView fx:id="medicineTableView" prefHeight="450.0">
                    <columns>
                        <TableColumn fx:id="medicineCodeColumn" prefWidth="115.0" text="Medicine Code"/>
                        <TableColumn fx:id="medicineNameColumn" prefWidth="165.0" text="Medicine Name"/>
                        <TableColumn fx:id="categoryColumn" prefWidth="120.0" text="Category"/>
                        <TableColumn fx:id="batchNumberColumn" prefWidth="110.0" text="Batch"/>
                        <TableColumn fx:id="stockQuantityColumn" prefWidth="90.0" text="Stock"/>
                        <TableColumn fx:id="unitPriceColumn" prefWidth="90.0" text="Unit Price"/>
                        <TableColumn fx:id="expiryDateColumn" prefWidth="120.0" text="Expiry Date"/>
                        <TableColumn fx:id="stockStatusColumn" prefWidth="120.0" text="Status"/>
                    </columns>
                </TableView>

                <Label fx:id="statusLabel"
                       text="Ready"
                       textFill="BLACK"
                       style="-fx-background-color: white; -fx-border-color: black; -fx-padding: 10;"/>
            </children>
        </VBox>
    </children>
</AnchorPane>
