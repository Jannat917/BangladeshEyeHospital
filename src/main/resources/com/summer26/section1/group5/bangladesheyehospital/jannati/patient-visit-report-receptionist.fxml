<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="650.0" prefWidth="900.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.summer26.section1.group5.bangladesheyehospital.jannati.PatientVisitReportController">

    <children>

        <!-- Title -->

        <Label layoutX="300.0" layoutY="20.0" text="Patient Visit Report">
            <font>
                <Font size="24.0" />
            </font>
        </Label>

        <!-- Search -->

        <Label layoutX="39.0" layoutY="107.0" text="Patient ID" />

        <TextField fx:id="patientIdTextField" layoutX="155.0" layoutY="102.0" prefWidth="180.0" />

        <Button layoutX="471.0" layoutY="102.0" onAction="#searchButton" prefHeight="57.0" prefWidth="125.0" text="Search" />

        <!-- Patient Information -->

        <Label layoutX="39.0" layoutY="159.0" text="Patient Name" />

        <TextField fx:id="patientNameTextField" editable="false" layoutX="155.0" layoutY="154.0" prefWidth="250.0" />

        <Label layoutX="37.0" layoutY="203.0" text="Last Visit Date" />

        <TextField fx:id="lastVisitDateTextField" editable="false" layoutX="155.0" layoutY="198.0" prefWidth="200.0" />

        <!-- Disease -->

        <Label layoutX="44.0" layoutY="378.0" text="Disease" />

        <TextArea fx:id="diseaseTextArea" editable="false" layoutX="146.0" layoutY="378.0" prefHeight="70.0" prefWidth="630.0" wrapText="true" />

        <!-- Diagnostic Report -->

        <Label layoutX="38.0" layoutY="251.0" text="Doctor Name :" />

        <!-- Buttons -->

        <Button layoutX="280.0" layoutY="485.0" onAction="#clearButton" prefHeight="26.0" prefWidth="200.0" text="Clear" />

        <Button layoutX="640.0" layoutY="578.0" onAction="#backButton" prefHeight="42.0" prefWidth="125.0" text="Back" />

        <!-- Message -->

        <Label fx:id="messageLabel" layoutX="40.0" layoutY="620.0" prefWidth="700.0" />
      <TextField fx:id="doctorNameTextField" editable="false" layoutX="155.0" layoutY="246.0" prefWidth="250.0" />
      <Label layoutX="38.0" layoutY="312.0" text="Doctor Id :" />
      <TextField fx:id="doctorIdTextField" editable="false" layoutX="155.0" layoutY="299.0" prefWidth="250.0" />

    </children>

</AnchorPane>
