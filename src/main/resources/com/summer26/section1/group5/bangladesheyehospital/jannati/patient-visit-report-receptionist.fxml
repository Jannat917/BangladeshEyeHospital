<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="650.0" prefWidth="900.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.summer26.section1.group5.bangladesheyehospital.jannati.PatientVisitReportController">

    <children>

        <!-- Title -->

        <Label layoutX="300.0" layoutY="20.0" text="Patient Visit Report">
            <font>
                <Font size="24.0" />
            </font>
        </Label>

        <!-- Search -->

        <Label layoutX="58.0" layoutY="192.0" text="Patient ID" />

        <TextField fx:id="patientIdTextField" layoutX="175.0" layoutY="179.0" prefWidth="180.0" />

        <Button layoutX="471.0" layoutY="102.0" onAction="#searchButton" prefHeight="57.0" prefWidth="125.0" text="Search" />

        <!-- Patient Information -->

        <Label layoutX="39.0" layoutY="253.0" text="Patient Name" />

        <TextField fx:id="patientNameTextField" editable="false" layoutX="175.0" layoutY="235.0" prefWidth="250.0" />

        <Label layoutX="45.0" layoutY="301.0" text="Last Visit Date" />

        <TextField fx:id="lastVisitDateTextField" editable="false" layoutX="175.0" layoutY="296.0" prefWidth="200.0" />

        <!-- Diagnostic Report -->

        <Label layoutX="45.0" layoutY="348.0" text="Doctor Name :" />

        <!-- Buttons -->

        <Button layoutX="280.0" layoutY="485.0" onAction="#clearButton" prefHeight="26.0" prefWidth="200.0" text="Clear" />

        <Button layoutX="640.0" layoutY="578.0" onAction="#backButton" prefHeight="42.0" prefWidth="125.0" text="Back" />

        <!-- Message -->

        <Label fx:id="messageLabel" layoutX="40.0" layoutY="620.0" prefWidth="700.0" />
      <TextField fx:id="doctorNameTextField" editable="false" layoutX="175.0" layoutY="343.0" prefWidth="250.0" />
      <Label layoutX="48.0" layoutY="402.0" text="Doctor Id :" />
      <TextField fx:id="doctorIdTextField" editable="false" layoutX="175.0" layoutY="389.0" prefWidth="250.0" />
      <Label layoutX="30.0" layoutY="142.0" text="Appointment Id : " />
      <TextField fx:id="appointmentIdTextField" layoutX="175.0" layoutY="129.0" prefWidth="180.0" />

    </children>

</AnchorPane>
