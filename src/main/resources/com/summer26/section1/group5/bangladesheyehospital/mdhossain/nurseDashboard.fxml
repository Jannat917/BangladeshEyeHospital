<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.summer26.section1.group5.bangladesheyehospital.mdhossain.NurseDashboardController"
            prefHeight="720.0" prefWidth="1200.0"
            style="-fx-background-color: #f4f7fb;">

    <left>
        <VBox prefWidth="260.0" spacing="14.0"
              style="-fx-background-color: #132238;"
              BorderPane.alignment="CENTER">
            <padding>
                <Insets top="24" right="18" bottom="24" left="18"/>
            </padding>

            <VBox spacing="6.0">
                <Label text="Bangladesh Eye Hospital"
                       style="-fx-text-fill: white; -fx-font-size: 18px; -fx-font-weight: bold;"/>
                <Label text="Nurse Dashboard"
                       style="-fx-text-fill: #d8e1ef; -fx-font-size: 14px;"/>
            </VBox>

            <Separator prefWidth="220.0"/>

            <Button text="Dashboard" maxWidth="Infinity"
                    style="-fx-background-color: #2d4f7c; -fx-text-fill: white; -fx-font-size: 14px;"
                    onAction="#goDashboard"/>

            <Button text="Initial Eye Screening" maxWidth="Infinity"
                    style="-fx-background-color: #1e2f47; -fx-text-fill: white;"
                    onAction="#openInitialEyeScreening"/>

            <Button text="Manage Doctor Queues" maxWidth="Infinity"
                    style="-fx-background-color: #1e2f47; -fx-text-fill: white;"
                    onAction="#openDoctorQueues"/>

            <Button text="Medical History" maxWidth="Infinity"
                    style="-fx-background-color: #1e2f47; -fx-text-fill: white;"
                    onAction="#openMedicalHistory"/>

            <Button text="Assign Doctors" maxWidth="Infinity"
                    style="-fx-background-color: #1e2f47; -fx-text-fill: white;"
                    onAction="#openAssignDoctor"/>

            <Button text="Head Nurse" maxWidth="Infinity"
                    style="-fx-background-color: #1e2f47; -fx-text-fill: white;"
                    onAction="#openHeadNurse"/>

            <Button text="Track Medications" maxWidth="Infinity"
                    style="-fx-background-color: #1e2f47; -fx-text-fill: white;"
                    onAction="#openMedicationTracking"/>

            <Button text="Discharge Summaries" maxWidth="Infinity"
                    style="-fx-background-color: #1e2f47; -fx-text-fill: white;"
                    onAction="#openDischargeSummaries"/>

            <Button text="Allocate Ward / Bed" maxWidth="Infinity"
                    style="-fx-background-color: #1e2f47; -fx-text-fill: white;"
                    onAction="#openBedAllocation"/>

            <VBox VBox.vgrow="ALWAYS"/>

            <Button text="Logout" maxWidth="Infinity"
                    style="-fx-background-color: #d9534f; -fx-text-fill: white; -fx-font-size: 14px;"
                    onAction="#logout"/>
        </VBox>
    </left>

    <top>
        <HBox spacing="12.0" alignment="CENTER_LEFT"
              style="-fx-background-color: white; -fx-border-color: #d9e2ec; -fx-border-width: 0 0 1 0;">
            <padding>
                <Insets top="18" right="24" bottom="18" left="24"/>
            </padding>

            <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                <Label text="Welcome, Nurse!"
                       style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #102a43;"/>
                <Label fx:id="subtitleLabel"
                       text="Manage screening, queues, history, medication, discharge, and bed allocation."
                       style="-fx-font-size: 13px; -fx-text-fill: #627d98;"/>
            </VBox>

            <VBox alignment="CENTER_RIGHT" spacing="3.0">
                <Label fx:id="todayLabel"
                       text="Today"
                       style="-fx-font-size: 14px; -fx-text-fill: #334e68;"/>
                <Label fx:id="timeLabel"
                       text="--:--"
                       style="-fx-font-size: 13px; -fx-text-fill: #627d98;"/>
            </VBox>
        </HBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent;" hbarPolicy="NEVER">
            <content>
                <VBox spacing="18.0" style="-fx-background-color: transparent;">
                    <padding>
                        <Insets top="24" right="24" bottom="24" left="24"/>
                    </padding>

                    <FlowPane hgap="16.0" vgap="16.0" prefWrapLength="880.0">
                        <StackPane prefWidth="210.0" prefHeight="110.0"
                                   style="-fx-background-color: white; -fx-background-radius: 16; -fx-border-radius: 16; -fx-border-color: #e3e8ee;">
                            <VBox alignment="CENTER_LEFT" spacing="8.0">
                                <padding>
                                    <Insets top="18" right="18" bottom="18" left="18"/>
                                </padding>
                                <Label text="Waiting Patients" style="-fx-font-size: 13px; -fx-text-fill: #627d98;"/>
                                <Label fx:id="waitingPatientsLabel" text="24"
                                       style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #102a43;"/>
                            </VBox>
                        </StackPane>

                        <StackPane prefWidth="210.0" prefHeight="110.0"
                                   style="-fx-background-color: white; -fx-background-radius: 16; -fx-border-radius: 16; -fx-border-color: #e3e8ee;">
                            <VBox alignment="CENTER_LEFT" spacing="8.0">
                                <padding>
                                    <Insets top="18" right="18" bottom="18" left="18"/>
                                </padding>
                                <Label text="Active Queues" style="-fx-font-size: 13px; -fx-text-fill: #627d98;"/>
                                <Label fx:id="activeQueuesLabel" text="6"
                                       style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #102a43;"/>
                            </VBox>
                        </StackPane>

                        <StackPane prefWidth="210.0" prefHeight="110.0"
                                   style="-fx-background-color: white; -fx-background-radius: 16; -fx-border-radius: 16; -fx-border-color: #e3e8ee;">
                            <VBox alignment="CENTER_LEFT" spacing="8.0">
                                <padding>
                                    <Insets top="18" right="18" bottom="18" left="18"/>
                                </padding>
                                <Label text="Medications Logged" style="-fx-font-size: 13px; -fx-text-fill: #627d98;"/>
                                <Label fx:id="medicationsLabel" text="18"
                                       style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #102a43;"/>
                            </VBox>
                        </StackPane>

                        <StackPane prefWidth="210.0" prefHeight="110.0"
                                   style="-fx-background-color: white; -fx-background-radius: 16; -fx-border-radius: 16; -fx-border-color: #e3e8ee;">
                            <VBox alignment="CENTER_LEFT" spacing="8.0">
                                <padding>
                                    <Insets top="18" right="18" bottom="18" left="18"/>
                                </padding>
                                <Label text="Beds Occupied" style="-fx-font-size: 13px; -fx-text-fill: #627d98;"/>
                                <Label fx:id="occupiedBedsLabel" text="12"
                                       style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #102a43;"/>
                            </VBox>
                        </StackPane>
                    </FlowPane>

                    <HBox spacing="18.0" prefHeight="340.0">
                        <VBox spacing="12.0" prefWidth="430.0"
                              style="-fx-background-color: white; -fx-background-radius: 16; -fx-border-radius: 16; -fx-border-color: #e3e8ee;">
                            <padding>
                                <Insets top="18" right="18" bottom="18" left="18"/>
                            </padding>
                            <Label text="Quick Actions"
                                   style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #102a43;"/>
                            <Separator/>
                            <Button text="1. Initial Eye Screening" maxWidth="Infinity" onAction="#openInitialEyeScreening"/>
                            <Button text="2. Manage Doctor Queues" maxWidth="Infinity" onAction="#openDoctorQueues"/>
                            <Button text="3. Retrieve Medical History" maxWidth="Infinity" onAction="#openMedicalHistory"/>
                            <Button text="4. Assign Doctors" maxWidth="Infinity" onAction="#openAssignDoctor"/>
                            <Button text="5. Head Nurse" maxWidth="Infinity" onAction="#openHeadNurse"/>
                            <Button text="6. Track Medications" maxWidth="Infinity" onAction="#openMedicationTracking"/>
                            <Button text="7. Discharge Summaries" maxWidth="Infinity" onAction="#openDischargeSummaries"/>
                            <Button text="8. Allocate Ward / Bed" maxWidth="Infinity" onAction="#openBedAllocation"/>
                        </VBox>

                        <VBox spacing="12.0" HBox.hgrow="ALWAYS"
                              style="-fx-background-color: white; -fx-background-radius: 16; -fx-border-radius: 16; -fx-border-color: #e3e8ee;">
                            <padding>
                                <Insets top="18" right="18" bottom="18" left="18"/>
                            </padding>
                            <Label text="Today's Nursing Workflow"
                                   style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #102a43;"/>
                            <Separator/>

                            <VBox spacing="10.0">
                                <Label text="• Screen new patients and record eye test values"/>
                                <Label text="• Move patients through doctor-specific queues"/>
                                <Label text="• Review prior medical history before consultation"/>
                                <Label text="• Assign available doctors based on load"/>
                                <Label text="• Track medication usage and update stock"/>
                                <Label text="• Prepare discharge summaries and bed allocation"/>
                            </VBox>

                            <Separator/>

                            <Label fx:id="statusLabel"
                                   text="System ready. Select a task from the sidebar."
                                   style="-fx-font-size: 14px; -fx-text-fill: #334e68;"/>
                        </VBox>
                    </HBox>
                </VBox>
            </content>
        </ScrollPane>
    </center>
</BorderPane>